{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../../packages/ts/src/index.ts"],
  "entryPointStrategy": "resolve",
  "tsconfig": "../../packages/ts/tsconfig.json",
  "out": ".vuepress/public/api/typescript/latest",
  "json": ".vuepress/api-typescript.json",
  "name": "gmkitx API",
  "lang": "zh",
  "readme": "api/public-api.md",
  "customCss": ".vuepress/styles/typedoc.css",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "cleanOutputDir": true,
  "githubPages": false,
  "searchInComments": true,
  "sourceLinkExternal": true,
  "navigationLinks": {
    "GMKit 文档": "https://gmkit.cn/",
    "使用指南": "https://gmkit.cn/guide/typescript.html"
  },
  "hostedBaseUrl": "https://gmkit.cn/api/typescript/latest/",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Enum",
    "EnumMember",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Property",
    "Method",
    "Accessor",
    "TypeAlias"
  ],
  "treatWarningsAsErrors": true
}
