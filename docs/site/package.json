{
  "name": "gmkit-docs-site",
  "version": "0.10.1",
  "private": true,
  "description": "Documentation portal for GMKit Java and TypeScript packages",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vuepress dev .",
    "prebuild": "node scripts/clean.mjs",
    "build": "vuepress build .",
    "postbuild": "node scripts/compress-site.mjs",
    "generate:api:typescript": "typedoc --options typedoc.json",
    "generate:api:java": "node scripts/generate-java-api.mjs",
    "generate:api:manifest": "node scripts/generate-api-manifest.mjs",
    "generate:api:versions": "node scripts/generate-api-versions.mjs",
    "generate:api": "npm run generate:api:typescript && npm run generate:api:java && npm run generate:api:manifest && npm run generate:api:versions",
    "check:api": "node scripts/check-api.mjs",
    "docs:check-api": "node scripts/check-api.mjs",
    "check:links": "node scripts/check-links.mjs",
    "clean": "node scripts/clean.mjs",
    "check": "node --test scripts/*.test.mjs && node scripts/check-docs.mjs",
    "docs:check": "npm run check",
    "docs:check-deploy": "node ../../.github/scripts/test-deploy-docs-origin.mjs",
    "test:examples": "node scripts/test-examples.mjs"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "^2.0.0-rc.26",
    "@vuepress/plugin-markdown-ext": "^2.0.0-rc.118",
    "@vuepress/plugin-markdown-tab": "^2.0.0-rc.118",
    "katex": "^0.16.25",
    "linkinator": "^7.6.1",
    "mermaid": "^11.12.1",
    "sass": "^1.94.2",
    "typedoc": "^0.28.20",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vuepress": "^2.0.0-rc.24",
    "vuepress-theme-hope": "^2.0.0-rc.94"
  }
}
