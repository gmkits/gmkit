<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.gmkit</groupId>
        <artifactId>gmkit-parent</artifactId>
        <version>0.10.1</version>
    </parent>

    <artifactId>gmkit-sm9</artifactId>
    <name>GMKit SM9</name>
    <description>GMKit SM9 Java API，通过 JNI 桥接 GmSSL，并在单一 JAR 中提供多平台 native runtime</description>

    <dependencies>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15to18</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/sm9-runtime</directory>
            </resource>
            <resource>
                <directory>${maven.multiModuleProjectDirectory}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
            <resource>
                <directory>${maven.multiModuleProjectDirectory}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF/licenses/gmssl</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>animal-sniffer-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          native-build 用于在已安装 GmSSL v3.1.1 的机器上编译 JNI 桥接库。
          默认构建不会触发 C 编译，因此在未安装 GmSSL 的环境（含普通 CI）也能正常
          编译 Java 与运行测试（无 native 库时测试会被 Assumptions 优雅跳过）。

          使用方式：
            mvn -pl gmkit-sm9 -Pnative-build -Dgmssl.root=/usr/local process-classes
        -->
        <profile>
            <id>native-build</id>
            <properties>
                <gmssl.root>/usr/local</gmssl.root>
                <cmake.build.type>Release</cmake.build.type>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>cmake-configure</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <condition property="cmake.generator.args" value="-G &quot;${cmake.generator}&quot;" else="">
                                            <isset property="cmake.generator"/>
                                        </condition>
                                        <condition property="cmake.platform.args" value="-A ${cmake.generator.platform}" else="">
                                            <isset property="cmake.generator.platform"/>
                                        </condition>
                                        <mkdir dir="${project.build.directory}/native-build"/>
                                        <exec executable="cmake" dir="${project.build.directory}/native-build"
                                              failonerror="true">
                                            <arg value="-DCMAKE_BUILD_TYPE=${cmake.build.type}"/>
                                            <arg value="-DGMSSL_ROOT=${gmssl.root}"/>
                                            <arg line="${cmake.generator.args}"/>
                                            <arg line="${cmake.platform.args}"/>
                                            <arg value="${project.basedir}/src/main/c"/>
                                        </exec>
                                        <exec executable="cmake" dir="${project.build.directory}/native-build"
                                              failonerror="true">
                                            <arg value="--build"/>
                                            <arg value="."/>
                                            <arg value="--config"/>
                                            <arg value="${cmake.build.type}"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <encoding>${project.build.sourceEncoding}</encoding>
                            <docencoding>${project.build.sourceEncoding}</docencoding>
                            <charset>${project.build.sourceEncoding}</charset>
                            <source>${maven.compiler.source}</source>
                            <doclint>all</doclint>
                            <failOnWarnings>true</failOnWarnings>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>sm9-runtime-bundle</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-complete-sm9-runtime-bundle</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/linux-x86_64/libgmkitsm9.so</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/linux-x86_64/libgmssl.so.3</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/linux-aarch64/libgmkitsm9.so</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/linux-aarch64/libgmssl.so.3</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/darwin-x86_64/libgmkitsm9.dylib</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/darwin-x86_64/libgmssl.3.dylib</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/darwin-aarch64/libgmkitsm9.dylib</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/darwin-aarch64/libgmssl.3.dylib</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/windows-x86_64/gmkitsm9.dll</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/native/windows-x86_64/gmssl.dll</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/META-INF/gmkit/sm9-native.properties</file>
                                                <file>${project.build.directory}/generated-resources/sm9-runtime/META-INF/gmkit/sm9-native.sha256</file>
                                            </files>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
