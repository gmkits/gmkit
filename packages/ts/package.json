{
  "name": "gmkitx",
  "version": "0.10.1",
  "description": "中国国密算法（SM2, SM3, SM4, ZUC）的纯 TypeScript 实现 / Pure TypeScript implementation of Chinese national cryptographic algorithms (SM2, SM3, SM4, ZUC)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "browser": {
    "./dist/index.cjs": "./dist/index.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build:raw": "tsup",
    "build": "node scripts/build-with-warning-policy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "type-check": "tsc --noEmit",
    "audit:pack": "node scripts/audit-pack-size.mjs",
    "test:package": "node scripts/test-package-consumer.mjs",
    "test:package-negative": "node --test scripts/test-package-consumer-negative.mjs",
    "audit:docs:assets": "node scripts/audit-doc-assets.mjs",
    "audit:slim": "npm run audit:docs:assets && npm run build && npm run audit:pack",
    "verify": "npm run type-check && npm run test && npm run build && npm run audit:pack && npm run test:package-negative && npm run test:package",
    "studio:dev": "npm run dev -w apps/gmkit-studio",
    "prepublishOnly": "npm run verify",
    "docs:dev": "npm run dev -w docs/site",
    "docs:build": "npm run build -w docs/site",
    "docs:clean": "npm run clean -w docs/site",
    "test:coverage": "vitest run --coverage",
    "test:lint-config": "node --test scripts/test-lint-config.mjs",
    "lint": "npm run test:lint-config && eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "sm2",
    "sm3",
    "sm4",
    "zuc",
    "cryptography",
    "chinese-standard",
    "state-cipher",
    "gm",
    "guomi",
    "eea3",
    "eia3",
    "lte",
    "国密",
    "商密",
    "加密",
    "签名",
    "信创"
  ],
  "author": "yulin.1996@foxmail.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/gmkits/gmkit.git",
    "directory": "packages/ts"
  },
  "bugs": {
    "url": "https://github.com/gmkits/gmkit/issues"
  },
  "homepage": "https://github.com/gmkits/gmkit/tree/main/packages/ts#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "^16.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "4.1.11"
  }
}
